/cli/serve_delegate_proxy.cpp"]}, {"commit": "e2d2c5920cd6e1871c09d272cb5394f7501cbc5d", "status": "M", "paths": ["edge0-infer/tools/cli/serve_delegate_proxy.cpp"]}, {"commit": "e2d2c5920cd6e1871c09d272cb5394f7501cbc5d", "status": "M", "paths": ["edge0-infer/tools/cli/serve_delegate_status.cpp"]}, {"commit": "e2d2c5920cd6e1871c09d272cb5394f7501cbc5d", "status": "M", "paths": ["edge0-infer/tools/cli/serve_delegate_status.h"]}, {"commit": "e61aea4d70eb116456d2aef52334ba202fb1a33a", "status": "M", "paths": ["edge0-infer/tools/cli/serve_delegate_proxy.cpp"]}, {"commit": "4cca27cfe0e8e2351b63fd8bd022668799a772b1", "status": "A", "paths": ["edge0-infer/tools/cli/serve_delegate_proxy.cpp"]}, {"commit": "4cca27cfe0e8e2351b63fd8bd022668799a772b1", "status": "A", "paths": ["edge0-infer/tools/cli/serve_delegate_status.cpp"]}, {"commit": "4cca27cfe0e8e2351b63fd8bd022668799a772b1", "status": "A", "paths": ["edge0-infer/tools/cli/serve_delegate_status.h"]}]
2026-11-16T21:48:31.5503963Z SSE_HISTORY_VERSION={"blob": "d6dd7d223d1a5301bf30719139a8ee43f24b1c33", "paths": ["edge0-infer/tools/cli/serve_delegate_proxy.cpp"], "source": "#include \"serve_delegate.h\"\n#include \"serve_delegate_status.h\"\n#include \"serve_status.h\"\n#include \"serve_protocol.h\"\n#include \"edge0/diagnostics.h\"\n#include <httplib.h>\n#include <condition_variable>\n#include <csignal>\n#include <cstdlib>\n#include <ctime>\n#include <deque>\n#include <exception>\n#include <fstream>\n#include <iomanip>\n#include <iostream>\n#include <set>\n#include <sstream>\n\n// serve in delegate mode: edge0-strata runs on a loopback port and this process is\n// its proxy. Generation endpoints are forwarded byte for byte (SSE chunk by chunk);\n// /health, /v1/models and /status are answered here in Edge0's format (/health also\n// carries edge0-strata's own fields); GET /v1/status, /metrics and /props pass through.\nnamespace delegate {\nnamespace {\nusing Json = nlohmann::ordered_json;\nstd::atomic<bool> interrupted{false};\nvoid on_signal(int value) {\n#ifdef _WIN32\n    // The Windows CRT resets a signal handler before calling it. Keep repeated stop requests graceful.\n    std::signal(value, on_signal);\n#else\n    (void)value;\n#endif\n    interrupted = true;\n}\nstd::mutex log_mutex;\nvoid log(const std::string& text) {\n    std::lock_guard<std::mutex> lock(log_mutex);\n    std::cerr << text << '\\n' << std::flush;\n}\nstd::string timestamp() {\n    const auto now = std::chrono::system_clock::now();\n    const auto value = std::chrono::system_clock::to_time_t(now);\n    std::tm utc{};\n#ifdef _WIN32\n    gmtime_s(&utc, &value);\n#else\n    gmtime_r(&value, &utc);\n#endif\n    std::ostringstream out;\n    out << std::put_time(&utc, \"%Y-%m-%dT%H:%M:%S\") << '.' << std::setfill('0') << std::setw(3)\n        << std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count() % 1000 << 'Z';\n    return out.str();\n}\nJson error_body(const std::string& message, const std::string& code, int status=500, const std::string& path={}) {\n    if(path==\"/v1/messages\" || path.rfind(\"/v1/messages/\",0)==0)return portal::Failure(status,message,code).body(portal::Protocol::messages);\n    return {{\"error\", {{\"message\", message}, {\"type\", \"server_error\"}, {\"code\", code}, {\"param\", nullptr}}}};\n}\n\n// One forwarded request: a worker thread performs the upstream call and hands the\n// response over as it arrives; the HTTP handler (or its chunked provider) relays it.\nstruct Forward {\n    std::mutex mutex;\n    std::condition_variable changed;\n    std::deque<std::string> chunks;\n    bool headers = false, done = false, failed = false, complete = false;\n    int status = 0;\n    std::string content_type, body, failure_code, failure_message;\n    std::atomic<bool> cancel{false};\n    std::unique_ptr<httplib::Client> client;\n    std::thread worker;\n    std::chrono::steady_clock::time_point started = std::chrono::steady_clock::now();\n    std::string endpoint, source;\n    bool stream = false, client_gone = false;\n    Accounting accounting;\n    std::string pending;\n    void abort() {\n        cancel = true;\n        if (client) client->stop();\n    }\n    ~Forward() {\n        abort();\n        if (worker.joinable()) worker.join();\n    }\n};\n\nstruct ServeArgs {\n    CommonArgs common;\n    std::string host = \"127.0.0.1\", key_file;\n    int port = 8000, write_timeout = 30;\n    std::size_t max_body = 16 * 1024 * 1024;\n};\nServeArgs parse(int argc, char** argv) {\n    ServeArgs args;\n    for (int i = 2; i < argc; ++i) {\n        const std::string key = argv[i];\n        if (key == \"--verbose\") continue;\n        if (key == \"--no-warmup\") unsupported_option(key);\n        if (i + 1 >= argc) throw ConfigError(\"invalid_argument: missing value for \" + key);\n        const std::string value = argv[++i];\n        auto number = [&](std::int64_t limit) {\n            if (value.empty() || value.size() > 18 || value.find_first_not_of(\"0123456789\") != std::string::npos || std::stoll(value) > limit)\n                throw ConfigError(\"invalid_argument: invalid value for \" + key);\n            return std::stoll(value);\n        };\n        if (common_argument(key, value, args.common)) {}\n        else if (key == \"--host\") args.host = value;\n        else if (key == \"--port\") args.port = static_cast<int>(number(65535));\n        else if (key == \"--api-key-file\") args.key_file = value;\n        else if (key == \"--write-timeout-seconds\") { args.write_timeout = static_cast<int>(number(INT32_MAX)); if (!args.write_timeout) throw ConfigError(\"invalid_argument: invalid write timeout\"); }\n        else if (key == \"--max-body-bytes\") args.max_body = static_cast<std::size_t>(number(INT64_MAX));\n        else unsupported_option(key);\n    }\n    return args;\n}\n}\n\nint serve(int argc, char** argv, const Match& match) {\n    try {\n        const auto args = parse(argc, argv);\n        const char* cuda_path = std::getenv(\"CUDA_PATH\");\n        const auto options = resolve(args.common, match, executable_path(argv[0]), host_platform(), cuda_path ? cuda_path : \"\");\n        for (const auto& warning : options.warnings) std::cerr << \"warning: \" << warning << '\\n';\n        std::string api_token;\n        if (!args.key_file.empty()) {\n            std::ifstream input(args.key_file, std::ios::binary);\n            if (!input) throw ConfigError(\"Cannot read API key file\");\n            std::ostringstream content;\n            content << input.rdbuf();\n            api_token = content.str();\n            const auto first = api_token.find_first_not_of(\" \\t\\r\\n\\f\\v\");\n            if (first == std::string::npos) throw ConfigError(\"API key file is empty\");\n            api_token = api_token.substr(first, api_token.find_last_not_of(\" \\t\\r\\n\\f\\v\") - first + 1);\n        }\n        if (!portal::loopback(args.host) && args.host != \"localhost\" && api_token.empty())\n            throw ConfigError(\"Non-loopback listening requires --api-key-file\");\n\n        interrupted = false;\n        auto old_int = std::signal(SIGINT, on_signal), old_term = std::signal(SIGTERM, on_signal);\n#ifdef _WIN32\n        auto old_break = std::signal(SIGBREAK, on_signal);\n        struct RestoreBreak { void (*handler)(int); ~RestoreBreak() { std::signal(SIGBREAK, handler); } } restore_break{old_break};\n#endif\n        struct Restore {\n            void (*a)(int); void (*b)(int);\n            ~Restore() { std::signal(SIGINT, a); std::signal(SIGTERM, b); }\n        } restore{old_int, old_term};\n\n        log(\"edge0-strata: starting \" + match.registration->id + \" from \" + options.strata_dir.string() + \" on \" + options.device);\n        auto launched = launch(*match.registration, options, {}, &interrupted);\n        auto& engine = *launched->engine;\n        const int upstream_port = engine.port();\n        log(\"edge0-strata: ready (pid \" + std::to_string(engine.pid()) + \", port \" + std::to_string(upstream_port) + \")\");\n        auto fetch_status = [&]() -> Json {\n            httplib::Client client(\"127.0.0.1\", upstream_port);\n            client.set_tcp_nodelay(true);\n            client.set_connection_timeout(1);\n            client.set_read_timeout(3);\n            auto response = client.Get(\"/v1/status\");\n            if (!response || response->status != 200) return nullptr;\n            auto value = Json::parse(response->body, nullptr, false);\n            return value.is_discarded() ? Json(nullptr) : value;\n        };\n        std::optional<std::int64_t> context;\n        if (const auto status = fetch_status(); status.is_object() && status.contains(\"context\") && status[\"context\"].is_object() &&\n                                                status[\"context\"].contains(\"native\") && status[\"context\"][\"native\"].is_number_integer())\n            context = status[\"context\"][\"native\"].get<std::int64_t>();\n\n        const auto started = std::chrono::steady_clock::now();\n        const auto unix_ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();\n#ifdef _WIN32\n        const auto pid = GetCurrentProcessId();\n#else\n        const auto pid = getpid();\n#endif\n        const auto started_at = timestamp();\n        const std::string device = options.device;\n        std::atomic<bool> stopping{false};\n        std::mutex state_mutex;\n        ProxyHistory history;\n        std::set<std::shared_ptr<Forward>> active;\n        std::condition_variable idle;\n        auto save = [&](const ProxyRecord& record) {\n            std::lock_guard<std::mutex> lock(state_mutex);\n            history.add(record);\n            log(record_json(record).dump());\n        };\n        auto finish = [&](const std::shared_ptr<Forward>& f, int http_status) {\n            {\n                std::lock_guard<std::mutex> lock(state_mutex);\n                active.erase(f);\n                idle.notify_all();\n            }\n            ProxyRecord record;\n            record.time = timestamp();\n            record.endpoint = f->endpoint;\n            record.source = f->source;\n            record.stream = f->stream;\n            record.total_seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - f->started).count();\n            record.http_status = http_status;\n            record.accounting = f->accounting;\n            record.code = f->accounting.error_code;\n            record.message = f->accounting.error_message;\n            record.param = f->accounting.error_param;\n            record.entered = http_status < 400 || http_status >= 500;\n            if (http_status == 429) record.entered = false;\n            if (f->client_gone) record.stop_reason = \"cancelled\";\n            else if (http_status >= 400) record.stop_reason = \"failed\";\n            else record.stop_reason = stop_reason(f->accounting.finish);\n            if (http_status >= 400) {\n                const auto body = Json::parse(f->body, nullptr, false);\n                if (!body.is_discarded() && body.contains(\"error\") && body[\"error\"].is_object()) {\n                    const auto& error = body[\"error\"];\n                    if (error.contains(\"code\") && error[\"code\"].is_string()) record.code = error[\"code\"];\n                    else if (error.contains(\"type\") && error[\"type\"].is_string()) record.code = error[\"type\"];\n                    if (error.contains(\"message\") && error[\"message\"].is_string()) record.message = error[\"message\"];\n                    if (error.contains(\"param\") && error[\"param\"].is_string()) record.param = error[\"param\"];\n                }\n            }\n            if (!f->failure_code.empty()) {record.code = f->failure_code;record.message = f->failure_message;}\n            save(record);\n        };\n\n        httplib::Server server;\n        server.set_tcp_nodelay(true);\n        server.set_socket_options([](socket_t socket) {\n#ifdef _WIN32\n            const auto option = SO_EXCLUSIVEADDRUSE;\n#else\n            const auto option = SO_REUSEADDR;\n#endif\n            if (!httplib::set_socket_opt(socket, SOL_SOCKET, option, 1)) throw std::runtime_error(\"Cannot configure exclusive server binding\");\n        });\n        server.new_task_queue = [] { return new httplib::ThreadPool(16); };\n        server.set_payload_max_length(args.max_body);\n        server.set_write_timeout(args.write_timeout);\n        auto send_error = [](httplib::Response& res, int status, const std::string& message, const std::string& code, const std::string& path=std::string{}) {\n            res.status = status;\n            res.set_content(error_body(message, code, status, path).dump(), \"application/json\");\n        };\n        server.set_error_handler([&](const httplib::Request& req, httplib::Response& res) {\n            if (res.status == 413) send_error(res, 413, \"Request body too large\", \"request_too_large\", req.path);\n            else if (res.body.empty()) res.set_content(proxy_error(res.status, req.path).dump(), \"application/json\");\n        });\n        server.set_pre_routing_handler([&](const httplib::Request& req, httplib::Response& res) {\n            if (portal::authorized(req.remote_addr, api_token, req.get_header_value(\"Authorization\"), req.get_header_value(\"x-api-key\")))\n                return httplib::Server::HandlerResponse::Unhandled;\n            send_error(res, 401, \"Invalid API key\", \"invalid_api_key\", req.path);\n            ProxyRecord record;\n            record.time = timestamp();\n            record.endpoint = req.path;\n            record.source = req.remote_addr;\n            record.http_status = 401;\n            record.code = \"invalid_api_key\";\n            record.message = \"Invalid API key\";\n            save(record);\n            return httplib::Server::HandlerResponse::Handled;\n        });\n        int bound_port = 0;\n        auto healthy = [&] { return !stopping && engine.running(); };\n        server.Get(\"/health\", [&](const httplib::Request&, httplib::Response& res) {\n            if (stopping) send_error(res, 503, \"Server shutting down\", \"shutting_down\");\n            else if (!engine.running()) send_error(res, 503, \"edge0-strata has exited\", \"engine_exited\");\n            else {\n                // Edge0's answer with edge0-strata's own /health fields merged in (status stays Edge0's), so that\n                // tools written for edge0-strata, such as its benchmark, recognize the proxy.\n                Json body{{\"status\", \"ok\"}};\n                httplib::Client client(\"127.0.0.1\", upstream_port);\n                client.set_tcp_nodelay(true);\n                client.set_connection_timeout(1);\n                client.set_read_timeout(3);\n                if (auto upstream = client.Get(\"/health\"); upstream && upstream->status == 200) {\n                    const auto value = Json::parse(upstream->body, nullptr, false);\n                    if (value.is_object())\n                        for (const auto& item : value.items())\n                            if (item.key() != \"status\") body[item.key()] = item.value();\n                }\n                res.set_content(body.dump(), \"application/json\");\n            }\n        });\n        // edge0-strata's own description endpoints, passed through unchanged for its tools (Edge0's is /status).\n        for (const char* path : {\"/v1/status\", \"/metrics\", \"/props\"})\n            server.Get(path, [&, path](const httplib::Request&, httplib::Response& res) {\n                if (!healthy()) {\n                    if (stopping) send_error(res, 503, \"Server shutting down\", \"shutting_down\");\n                    else send_error(res, 503, \"edge0-strata has exited\", \"engine_exited\");\n                    return;\n                }\n                httplib::Client client(\"127.0.0.1\", upstream_port);\n                client.set_tcp_nodelay(true);\n                client.set_connection_timeout(5);\n                client.set_read_timeout(60);\n                auto upstream = client.Get(path);\n                if (!upstream) {\n                    send_error(res, 502, \"edge0-strata did not answer \" + std::string(path), \"upstream_unavailable\");\n                    return;\n                }\n                res.status = upstream->status;\n                res.set_content(upstream->body, upstream->has_header(\"Content-Type\") ? upstream->get_header_value(\"Content-Type\")\n                                                                                      : std::string(\"application/octet-stream\"));\n            });\n        server.Post(\"/v1/messages/count_tokens\", [&](const httplib::Request& req, httplib::Response& res) {\n            if (!healthy()) {\n                send_error(res, 503, stopping ? \"Server shutting down\" : \"edge0-strata has exited\",\n                           stopping ? \"shutting_down\" : \"engine_exited\", req.path);\n                return;\n            }\n            httplib::Client client(\"127.0.0.1\", upstream_port);\n            client.set_tcp_nodelay(true);\n            client.set_connection_timeout(5);\n            client.set_read_timeout(60);\n            client.set_path_encode(false);\n            httplib::Headers headers;\n            for (const char* name : {\"Accept\", \"anthropic-version\", \"anthropic-beta\"})\n                if (req.has_header(name)) headers.emplace(name, req.get_header_value(name));\n            auto upstream = client.Post(req.target.empty() ? req.path : req.target, headers, req.body,\n                                        req.get_header_value(\"Content-Type\"));\n            if (!upstream) {send_error(res, 502, \"edge0-strata did not answer\", \"upstream_unavailable\", req.path);return;}\n            res.status = upstream->status;\n            res.set_content(upstream->body, upstream->has_header(\"Content-Type\") ? upstream->get_header_value(\"Content-Type\")\n                                                                               : \"application/octet-stream\");\n        });\n        auto model_object = [&] {\n            return Json{{\"id\", options.alias}, {\"object\", \"model\"}, {\"created\", 0}, {\"owned_by\", \"local\"},\n                        {\"context_length\", context ? Json(*context) : Json(nullptr)},\n                        {\"capabilities\", {{\"thinking\", match.registration->thinking}, {\"thinking_default\", match.registration->thinking_default}}}};\n        };\n        server.Get(\"/v1/models\", [&](const httplib::Request&, httplib::Response& res) {\n            res.set_content(Json{{\"object\", \"list\"}, {\"data\", Json::array({model_object()})}}.dump(), \"application/json\");\n        });\n        server.Get(R\"(/v1/models/(.+))\", [&](const httplib::Request& req, httplib::Response& res) {\n            if (req.matches[1].str() != options.alias) send_error(res, 404, \"Unknown model\", \"model_not_found\");\n            else res.set_content(model_object().dump(), \"application/json\");\n        });\n        server.Get(\"/status\", [&](const httplib::Request&, httplib::Response& res) {\n            DelegateStatusInput input;\n            input.now = std::chrono::steady_clock::now();\n            input.instance = {{\"id\", std::to_string(pid) + \"-\" + std::to_string(unix_ms)}, {\"pid\", pid}, {\"started_at\", started_at},\n                              {\"uptime_seconds\", std::chrono::duration<double>(input.now - started).count()}};\n            input.listen = {{\"host\", args.host}, {\"port\", bound_port}, {\"auth\", !api_token.empty()}};\n            input.alias = options.alias;\n            input.directory = args.common.model;\n            input.device = device;\n            input.context = context;\n            input.system = portal::system_json(edge0::query_system_status());\n            input.external = engine.running() ? fetch_status() : Json(nullptr);\n            {\n                std::lock_guard<std::mutex> lock(state_mutex);\n                input.history = history;\n                for (const auto& f : active)\n                    if (!input.active || f->started < input.active->started) {\n                        // The accounting is written under the forward's own mutex; copying it there gives the live\n                        // phase and fragment count without racing the forwarding thread.\n                        std::lock_guard<std::mutex> stream_lock(f->mutex);\n                        input.active = ActiveRequest{f->endpoint, f->source, f->started, f->accounting};\n                    }\n                // Taken after the copy, so the elapsed time is never negative and never below the time stamped on\n                // the first fragment of the copied accounting.\n                input.now = std::chrono::steady_clock::now();\n            }\n            res.set_content(status_json(input).dump(), \"application/json\");\n        });\n        auto forward = [&](const httplib::Request& req, httplib::Response& res) {\n            auto f = std::make_shared<Forward>();\n            f->endpoint = req.path;\n            f->source = req.remote_addr;\n            f->accounting.endpoint = req.path;\n            {\n                const auto body = Json::parse(req.body, nullptr, false);\n                f->stream = !body.is_discarded() && body.is_object() && body.contains(\"stream\") && body[\"stream\"] == true;\n                f->accounting.streaming = f->stream;\n            }\n            if (!healthy()) {\n                f->body = stopping ? error_body(\"Server shutting down\", \"shutting_down\",503,req.path).dump()\n                                   : error_body(\"edge0-strata has exited\", \"engine_exited\",503,req.path).dump();\n                res.status = 503;\n                res.set_content(f->body, \"application/json\");\n                finish(f, 503);\n                return;\n            }\n            f->client = std::make_unique<httplib::Client>(\"127.0.0.1\", upstream_port);\n            f->client->set_tcp_nodelay(true);\n            ActiveGuard guard([&] {\n                f->abort();\n                if (f->worker.joinable()) f->worker.join();\n                f->failure_code = \"internal_error\";\n                f->failure_message = \"Internal error\";\n                finish(f, 500);\n            });\n            {\n                std::lock_guard<std::mutex> lock(state_mutex);\n                active.insert(f);\n            }\n            guard.arm();\n            f->client->set_connection_timeout(5);\n            f->client->set_read_timeout(24 * 3600);\n            f->client->set_write_timeout(60);\n            f->client->set_path_encode(false);  // the target goes out exactly as received\n            httplib::Request upstream;\n            upstream.method = \"POST\";\n            upstream.path = req.target.empty() ? req.path : req.target;  // keeps the query string (?beta=true)\n            upstream.body = req.body;\n            for (const char* name : {\"Content-Type\", \"Accept\", \"anthropic-version\", \"anthropic-beta\"})\n                if (req.has_header(name)) upstream.set_header(name, req.get_header_value(name));\n            std::weak_ptr<Forward> weak = f;\n            Forward* raw = f.get();\n            upstream.response_handler = [raw](const httplib::Response& response) {\n                std::lock_guard<std::mutex> lock(raw->mutex);\n                raw->status = response.status;\n                raw->content_type = response.get_header_value(\"Content-Type\");\n                raw->headers = true;\n                raw->changed.notify_all();\n                return !raw->cancel;\n            };\n            upstream.content_receiver = [raw](const char* data, std::size_t size, std::size_t, std::size_t) {\n                std::lock_guard<std::mutex> lock(raw->mutex);\n                raw->chunks.emplace_back(data, size);\n                raw->changed.notify_all();\n                return !raw->cancel;\n            };\n            f->worker = std::thread([raw, upstream] {\n                auto result = raw->client->send(upstream);\n                std::lock_guard<std::mutex> lock(raw->mutex);\n                raw->failed = !result;\n                raw->done = true;\n                raw->changed.notify_all();\n            });\n            {\n                std::unique_lock<std::mutex> lock(f->mutex);\n                while (!f->headers && !f->done) {\n                    f->changed.wait_for(lock, std::chrono::milliseconds(20));\n                    if (!f->headers && req.is_connection_closed()) { f->client_gone = true; lock.unlock(); f->abort(); lock.lock(); }\n                }\n            }\n            auto incomplete = [&, f] {\n                for (int i = 0; i < 20 && !f->client_gone && !stopping && engine.running(); ++i)\n                    std::this_thread::sleep_for(std::chrono::milliseconds(50));\n                const int status = f->client_gone ? 499 : stopping || !engine.running() ? 503 : 502;\n                f->failure_code = f->client_gone ? \"cancelled\" : stopping ? \"shutting_down\" : status == 503 ? \"engine_exited\" : \"engine_unavailable\";\n                f->failure_message = f->client_gone ? \"Client disconnected\" : stopping ? \"Server shutting down\" : status == 503 ? \"edge0-strata has exited\" : \"edge0-strata did not finish its response\";\n                f->status = status;\n                f->body = error_body(f->failure_message, f->failure_code, status, f->endpoint).dump();\n            };\n            if (!f->headers) {\n                if (f->worker.joinable()) f->worker.join();\n                incomplete();\n                res.status = f->status;\n                res.set_content(f->body, \"application/json\");\n                finish(f, f->status);\n                guard.release();\n                return;\n            }\n            res.status = f->status;\n            if (f->content_type.compare(0, 17, \"text/event-stream\") == 0) {\n                res.set_chunked_content_provider(\n                    f->content_type,\n                    [f, &req, incomplete, &options](std::size_t, httplib::DataSink& sink) {\n                        std::unique_lock<std::mutex> lock(f->mutex);\n                        for (;;) {\n                            while (!f->chunks.empty()) {\n                                auto chunk = std::move(f->chunks.front());\n                                f->chunks.pop_front();\n                                try {\n                                    // The request's age when this chunk is forwarded; the first text fragment is\n                                    // stamped with it (current.first_token_seconds).\n                                    const double elapsed =\n                                        std::chrono::duration<double>(std::chrono::steady_clock::now() - f->started).count();\n                                    account_sse(f->accounting, f->pending, chunk.data(), chunk.size(), elapsed);\n                                } catch (const std::exception&) {\n                                    // Accounting never affects forwarding; the record keeps what was read.\n                                }\n                                lock.unlock();\n                                const bool written = sink.write(chunk.data(), chunk.size());\n                                lock.lock();\n                                if (!written) { f->client_gone = true; lock.unlock(); f->abort(); return false; }\n                            }\n                            if (f->done) break;\n                            f->changed.wait_for(lock, std::chrono::milliseconds(20));\n                            if (f->chunks.empty() && !f->done && (!sink.is_writable() || req.is_connection_closed())) {\n                                f->client_gone = true;\n                                lock.unlock();\n                                f->abort();\n                                return false;\n                            }\n                        }\n                        f->complete = !f->failed && f->accounting.complete;\n                        lock.unlock();\n                        if (!f->complete) {\n                            incomplete();\n                            if (f->client_gone) return false;\n                            portal::Request request;\n                            request.protocol = f->endpoint == \"/v1/messages\" ? portal::Protocol::messages\n                                : f->endpoint == \"/v1/responses\" ? portal::Protocol::responses : portal::Protocol::chat;\n                            portal::Encoder encoder(request, options.alias, \"\");\n                            const portal::Failure error(f->status, f->failure_message, f->failure_code);\n                            // A truncated last line must not consume the appended event as part of its data.\n                            if (!sink.write(\"\\n\\n\", 2)) {f->client_gone = true;return false;}\n                            for (const auto& event : encoder.fail(error, f->accounting.response_id, f->accounting.next_sequence))\n                                if (!sink.write(event.data(), event.size())) {f->client_gone = true;return false;}\n                        }\n                        sink.done();\n                        return true;\n                    },\n                    [f, finish](bool) {\n                        f->abort();\n                        if (f->worker.joinable()) f->worker.join();\n                        finish(f, f->status);\n                    });\n                guard.release();\n                return;\n            }\n            {\n                std::unique_lock<std::mutex> lock(f->mutex);\n                while (!f->done) {\n                    f->changed.wait_for(lock, std::chrono::milliseconds(20));\n                    if (!f->done && req.is_connection_closed()) { f->client_gone = true; lock.unlock(); f->abort(); lock.lock(); }\n                }\n                for (auto& chunk : f->chunks) f->body += chunk;\n                f->chunks.clear();\n            }\n            if (f->worker.joinable()) f->worker.join();\n            const bool json_content = f->content_type.find(\"application/json\") != std::string::npos || f->content_type.find(\"+json\") != std::string::npos;\n            const auto parsed = json_content ? Json::parse(f->body, nullptr, false) : Json(nullptr);\n            f->complete = !f->failed && (!json_content || !parsed.is_discarded());\n            if (!f->complete) {\n                incomplete();\n                res.status = f->status;\n                res.set_content(f->body, \"application/json\");\n                finish(f, f->status);\n                guard.release();\n                return;\n            }\n            try {\n                // Under the forward's mutex: /status copies the accounting of a request that is still active.\n                std::lock_guard<std::mutex> lock(f->mutex);\n                account(f->accounting, parsed);\n            } catch (const std::exception&) {\n                // Accounting never affects forwarding: the body goes out as received and the request is still\n                // recorded (fields that could not be read stay null) and leaves the active set.\n            }\n            res.set_content(f->body, f->content_type.empty() ? \"application/json\" : f->content_type.c_str());\n            finish(f, f->status);\n            guard.release();\n        };\n        for (const char* path : {\"/v1/chat/completions\", \"/v1/responses\", \"/v1/messages\"}) server.Post(path, forward);\n\n        const int port = args.port == 0 ? server.bind_to_any_port(args.host) : (server.bind_to_port(args.host, args.port) ? args.port : -1);\n        if (port < 0) throw std::runtime_error(\"Cannot bind server\");\n        bound_port = port;\n        std::atomic<bool> done{false};\n        std::thread watcher([&] {\n            bool reported = false;\n            while (!done) {\n                if (!reported && !engine.running()) {\n                    reported = true;\n                    log(\"edge0-strata exited (exit code \" + std::to_string(engine.exit_code().value_or(-1)) + \"); generation requests now return 503\");\n                }\n                if (interrupted) {\n                    log(\"stopping acceptance\");\n                    stopping = true;\n                    server.stop();\n                    std::unique_lock<std::mutex> lock(state_mutex);\n                    if (!idle.wait_for(lock, std::chrono::seconds(60), [&] { return active.empty(); })) {\n                        log(\"active requests did not finish within 60 s; cancelling them\");\n                        for (const auto& f : active) f->abort();\n                    }\n                    break;\n                }\n                std::this_thread::sleep_for(std::chrono::milliseconds(20));\n            }\n        });\n        log(\"Listening: http://\" + args.host + \":\" + std::to_string(port) + \" model=\" + options.alias);\n        const bool listened = server.listen_after_bind();\n        done = true;\n        watcher.join();\n        log(\"active requests finished\");\n        engine.stop(60);\n        log(\"edge0-strata stopped (exit code \" + std::to_string(engine.exit_code().value_or(-1)) + \")\");\n        return listened ? 0 : 1;\n    } catch (const ConfigError& error) {\n        log(std::string(\"configuration_error: \") + error.what());\n        return 2;\n    } catch (const std::exception& error) {\n        log(error.what());\n        return 1;\n    }\n}\n}\n"}
2026-11-16T21:48:31.5618613Z SSE_HISTORY_VERSION={"blob": "dfb48adced089e694f3efd7178ff51991ee8dba3", "paths": ["edge0-infer/tools/cli/serve_delegate_status.cpp"], "source": "#include \"serve_delegate_status.h\"\n#include \"serve_protocol.h\"\n#include <limits>\n\n#include <exception>\n\nnamespace delegate {\nnamespace {\nusing Json = StatusJson;\nstd::optional<std::int64_t> integer(const Json& object, const char* key) {\n    if (!object.is_object() || !object.contains(key) || !object[key].is_number()) return std::nullopt;\n    return object[key].get<std::int64_t>();\n}\nstd::optional<double> number(const Json& object, const char* key) {\n    if (!object.is_object() || !object.contains(key) || !object[key].is_number()) return std::nullopt;\n    return object[key].get<double>();\n}\ntemplate <class T> void take(std::optional<T>& target, const std::optional<T>& value) {\n    if (value) target = value;\n}\ntemplate <class T> Json nullable(const std::optional<T>& value) { return value ? Json(*value) : Json(nullptr); }\n// A string field, or \"\" when it is missing or not a string (a field of the wrong type counts as missing).\nstd::string text(const Json& object, const char* key) {\n    if (!object.is_object() || !object.contains(key) || !object[key].is_string()) return \"\";\n    return object[key].get<std::string>();\n}\nvoid finish_from(Accounting& a, const Json& value) {\n    if (value.is_string() && !value.get<std::string>().empty()) a.finish = value.get<std::string>();\n}\n// A Responses object's `status` is a finish only when terminal; in_progress and queued leave it unknown.\nvoid responses_status(Accounting& a, const Json& response) {\n    const auto status = text(response, \"status\");\n    if (status == \"completed\" || status == \"incomplete\" || status == \"failed\" || status == \"cancelled\") a.finish = status;\n}\n}\n\nvoid account(Accounting& a, const Json& body) {\n    if (!body.is_object()) return;\n    const std::string type = text(body, \"type\");\n    if (body.contains(\"usage\") && body[\"usage\"].is_object()) {\n        const auto& usage = body[\"usage\"];\n        const auto prompt = integer(usage, \"prompt_tokens\");\n        take(a.input_tokens, prompt);\n        if (prompt) {\n            // Chat usage: prompt_tokens stands even when the body also carries input_tokens.\n        } else if (type == \"message\") {\n            // Anthropic Messages: input_tokens counts only the uncached part; the request's input is all three\n            // (a missing one counts as 0).\n            const auto uncached = integer(usage, \"input_tokens\");\n            const auto created = integer(usage, \"cache_creation_input_tokens\");\n            const auto read = integer(usage, \"cache_read_input_tokens\");\n            if (uncached || created || read) a.input_tokens = uncached.value_or(0) + created.value_or(0) + read.value_or(0);\n        } else if (type != \"message_delta\") {\n            // message_delta repeats input counts; the one in message_start stands, the delta only adds the output.\n            take(a.input_tokens, integer(usage, \"input_tokens\"));\n        }\n        take(a.generated_tokens, integer(usage, \"completion_tokens\"));\n        take(a.generated_tokens, integer(usage, \"output_tokens\"));\n        if (usage.contains(\"prompt_tokens_details\") && !a.reused_tokens)\n            take(a.reused_tokens, integer(usage[\"prompt_tokens_details\"], \"cached_tokens\"));\n    }\n    if (body.contains(\"timings\") && body[\"timings\"].is_object()) {\n        const auto& t = body[\"timings\"];\n        take(a.reused_tokens, integer(t, \"cache_n\"));\n        take(a.prompt_tokens_read, integer(t, \"prompt_n\"));\n        take(a.predicted_tokens, integer(t, \"predicted_n\"));\n        if (auto ms = number(t, \"prompt_ms\")) a.prompt_seconds = *ms / 1000;\n        if (auto ms = number(t, \"predicted_ms\")) a.decode_seconds = *ms / 1000;\n        take(a.prefill_tokens_per_second, number(t, \"prompt_per_second\"));\n        take(a.decode_tokens_per_second, number(t, \"predicted_per_second\"));\n    }\n    if (body.contains(\"choices\") && body[\"choices\"].is_array())\n        for (const auto& choice : body[\"choices\"])\n            if (choice.is_object() && choice.contains(\"finish_reason\")) finish_from(a, choice[\"finish_reason\"]);\n    if (body.contains(\"stop_reason\")) finish_from(a, body[\"stop_reason\"]);\n    // A Responses object (the non-streaming body, or nested in a streamed event) states its finish in `status`.\n    if (text(body, \"object\") == \"response\") responses_status(a, body);\n    if (body.contains(\"delta\") && body[\"delta\"].is_object() && body[\"delta\"].contains(\"stop_reason\"))\n        finish_from(a, body[\"delta\"][\"stop_reason\"]);\n    // Responses and Anthropic Messages nest the final object.\n    for (const char* key : {\"response\", \"message\"})\n        if (body.contains(key) && body[key].is_object()) {\n            account(a, body[key]);\n            if (std::string(key) == \"response\") responses_status(a, body[key]);\n        }\n    // A protocol error can arrive after HTTP 200 headers have already been sent.\n    if (body.contains(\"error\") && body[\"error\"].is_object()) {\n        const auto& error = body[\"error\"];\n        a.finish = \"failed\";\n        a.error_code = error.contains(\"code\") && error[\"code\"].is_string() ? text(error, \"code\") : text(error, \"type\");\n        a.error_message = text(error, \"message\");\n        a.error_param = text(error, \"param\");\n    }\n}\n\nstd::int64_t content_fragments(const Json& event) {\n    if (!event.is_object()) return 0;\n    std::int64_t fragments = 0;\n    if (event.contains(\"choices\") && event[\"choices\"].is_array())\n        for (const auto& choice : event[\"choices\"]) {\n            if (!choice.is_object() || !choice.contains(\"delta\") || !choice[\"delta\"].is_object()) continue;\n            const auto& delta = choice[\"delta\"];\n            bool carries = !text(delta, \"content\").empty() || !text(delta, \"reasoning_content\").empty();\n            if (!carries && delta.contains(\"tool_calls\") && delta[\"tool_calls\"].is_array())\n                for (const auto& call : delta[\"tool_calls\"])\n                    if (call.is_object() && call.contains(\"function\") && !text(call[\"function\"], \"arguments\").empty()) carries = true;\n            if (carries) ++fragments;\n        }\n    const std::string type = text(event, \"type\");\n    if (type == \"response.output_text.delta\" || type == \"response.reasoning_text.delta\" ||\n        type == \"response.function_call_arguments.delta\" || type == \"response.custom_tool_call_input.delta\")\n        if (!text(event, \"delta\").empty()) ++fragments;\n    if (type == \"content_block_delta\" && event.contains(\"delta\") && event[\"delta\"].is_object()) {\n        const auto& delta = event[\"delta\"];\n        const std::string kind = text(delta, \"type\");\n        if ((kind == \"text_delta\" && !text(delta, \"text\").empty()) || (kind == \"thinking_delta\" && !text(delta, \"thinking\").empty()) ||\n            (kind == \"input_json_delta\" && !text(delta, \"partial_json\").empty()))\n            ++fragments;\n    }\n    return fragments;\n}\n\nvoid account_sse(Accounting& a, std::string& pending, const char* data, std::size_t size, double elapsed) {\n    pending.append(data, size);\n    std::size_t start = 0;\n    for (;;) {\n        const auto end = pending.find('\\n', start);\n        if (end == std::string::npos) break;\n        std::string line = pending.substr(start, end - start);\n        start = end + 1;\n        if (!line.empty() && line.back() == '\\r') line.pop_back();\n        if (line.compare(0, 5, \"data:\") != 0) continue;\n        auto payload = line.substr(5);\n        if (!payload.empty() && payload.front() == ' ') payload.erase(0, 1);\n        if (payload == \"[DONE]\") {\n            if (a.endpoint == \"/v1/chat/completions\") a.complete = true;\n            continue;\n        }\n        const auto value = Json::parse(payload, nullptr, false);\n        if (value.is_discarded()) continue;\n        try {\n            const auto type = text(value, \"type\");\n            if (a.endpoint == \"/v1/responses\") {\n                if (type == \"response.completed\" || type == \"response.incomplete\" || type == \"response.failed\") a.complete = true;\n                if (value.contains(\"response\") && value[\"response\"].is_object()) {\n                    const auto id = text(value[\"response\"], \"id\");\n                    if (!id.empty()) a.response_id = id;\n                }\n                const auto id = text(value, \"response_id\");\n                if (!id.empty()) a.response_id = id;\n                if (value.contains(\"sequence_number\") && value[\"sequence_number\"].is_number_integer() && value[\"sequence_number\"] >= 0) {\n                    const auto n = value[\"sequence_number\"].get<std::uint64_t>();\n                    if (n < std::numeric_limits<std::size_t>::max()) a.next_sequence = std::max(a.next_sequence, static_cast<std::size_t>(n) + 1);\n                }\n            } else if (a.endpoint == \"/v1/messages\" && (type == \"message_stop\" || type == \"error\")) a.complete = true;\n            else if (a.endpoint == \"/v1/chat/completions\" && value.contains(\"error\")) a.complete = true;\n            account(a, value);\n            if (const auto fragments = content_fragments(value)) {\n                a.streamed_tokens = a.streamed_tokens.value_or(0) + fragments;\n                if (!a.saw_content) a.first_token_seconds = elapsed;\n                a.saw_content = true;\n            }\n        } catch (const std::exception&) {\n            // Accounting never affects forwarding: an event that cannot be read is left out of the record.\n        }\n    }\n    pending.erase(0, start);\n}\n\nStatusJson proxy_error(int status, const std::string& path) {\n    return portal::http_failure(status).body(\n            path == \"/v1/messages\" || path.rfind(\"/v1/messages/\", 0) == 0 ? portal::Protocol::messages : portal::Protocol::chat);\n}\n\nstd::string stop_reason(const std::string& finish) {\n    if (finish == \"stop\" || finish == \"end_turn\" || finish == \"completed\") return \"end_of_generation\";\n    if (finish == \"length\" || finish == \"max_tokens\" || finish == \"incomplete\") return \"length\";\n    if (finish == \"tool_calls\" || finish == \"tool_use\") return \"tool_calls\";\n    if (finish == \"stop_sequence\") return \"stop_string\";\n    if (finish == \"cancel\" || finish == \"cancelled\") return \"cancelled\";\n    return finish.empty() ? \"unknown\" : finish;\n}\n\nJson record_json(const ProxyRecord& r) {\n    Json result{{\"time\", r.time}, {\"endpoint\", r.endpoint}, {\"source\", r.source}, {\"http_status\", r.http_status},\n                {\"stream\", r.stream}, {\"total_seconds\", r.total_seconds}};\n    if (!r.code.empty()) result[\"code\"] = r.code;\n    if (!r.message.empty()) result[\"message\"] = r.message;\n    if (!r.param.empty()) result[\"param\"] = r.param;\n    if (r.entered) {\n        const auto& a = r.accounting;\n        result[\"stop_reason\"] = r.stop_reason;\n        result[\"input_tokens\"] = nullable(a.input_tokens);\n        result[\"reused_tokens\"] = nullable(a.reused_tokens);\n        result[\"generated_tokens\"] = nullable(a.generated_tokens);\n        result[\"first_token_seconds\"] = nullable(a.prompt_seconds);\n        result[\"decode_tokens_per_second\"] = nullable(a.decode_tokens_per_second);\n        result[\"prefill_tokens_per_second\"] = nullable(a.prefill_tokens_per_second);\n        result[\"decode_seconds\"] = nullable(a.decode_seconds);\n    }\n    return result;\n}\n\nvoid ProxyHistory::add(const ProxyRecord& r) {\n    auto& t = totals;\n    if (!r.entered) {\n        if (r.http_status == 401) ++t.unauthorized;\n        else if (r.http_status == 429) ++t.rejected_busy;\n        else ++t.rejected_invalid;\n    } else {\n        const auto& a = r.accounting;\n        ++t.requests;\n        t.input_tokens += a.input_tokens.value_or(0);\n        t.reused_tokens += a.reused_tokens.value_or(0);\n        t.generated_tokens += a.generated_tokens.value_or(0);\n        if (a.prompt_seconds) {\n            ++t.first_count;\n            t.first_seconds += *a.prompt_seconds;\n            if (a.prompt_tokens_read) { t.prompt_tokens_read += *a.prompt_tokens_read; t.prompt_seconds += *a.prompt_seconds; }\n        }\n        if (a.decode_seconds) {\n            t.decode_seconds += *a.decode_seconds;\n            if (a.predicted_tokens) { t.predicted_tokens += *a.predicted_tokens; t.decode_seconds_rated += *a.decode_seconds; }\n        }\n        last = r;\n    }\n    recent.push_front(r);\n    if (recent.size() > 100) recent.pop_back();\n}\n\nJson system_memory(const Json& portal_system, const Json& external) {\n    Json system = portal_system;\n    const Json ram = external.is_object() && external.contains(\"machine\") && external[\"machine\"].is_object() &&\n                             external[\"machine\"].contains(\"ram\") ? external[\"machine\"][\"ram\"] : Json(nullptr);\n    auto value = [&](std::optional<double> gib) {\n        if (!gib) return Json{{\"bytes\", nullptr}, {\"source\", \"edge0-strata\"}, {\"reason\", \"not reported by edge0-strata\"}};\n        return Json{{\"bytes\", static_cast<std::int64_t>(*gib * 1073741824.0)}, {\"source\", \"edge0-strata\"}, {\"reason\", \"\"}};\n    };\n    const auto total = number(ram, \"total_gib\"), used = number(ram, \"used_gib\");\n    system[\"memory\"] = {{\"total\", value(total)},\n                        {\"available\", value(total && used ? std::optional<double>(*total - *used) : std::nullopt)}};\n    return system;\n}\n\nJson status_json(const DelegateStatusInput& s) {\n    const auto& external = s.external;\n    Json gpu = nullptr;\n    if (external.is_object() && external.contains(\"machine\") && external[\"machine\"].is_object() &&\n        external[\"machine\"].contains(\"gpu\") && external[\"machine\"][\"gpu\"].is_object())\n        gpu = external[\"machine\"][\"gpu\"];\n    Json devices = nullptr;\n    if (gpu.is_object()) {\n        const auto total = number(gpu, \"total_mib\"), used = number(gpu, \"used_mib\");\n        devices = Json::array({Json{{\"name\", s.device},\n                                    {\"backend\", s.device == \"metal\" ? \"metal\" : \"cuda\"},\n                                    {\"description\", gpu.contains(\"name\") && gpu[\"name\"].is_string() ? gpu[\"name\"] : Json(nullptr)},\n                                    {\"memory_total_bytes\", total ? Json(static_cast<std::int64_t>(*total * 1048576.0)) : Json(nullptr)},\n                                    {\"memory_free_bytes\", total && used ? Json(static_cast<std::int64_t>((*total - *used) * 1048576.0)) : Json(nullptr)}}});\n    }\n    Json version = external.is_object() && external.contains(\"engine\") && external[\"engine\"].is_string() ? external[\"engine\"] : Json(nullptr);\n    Json engine{{\"version\", version},          {\"source_commit\", nullptr}, {\"source_modified\", nullptr},\n                {\"source_reason\", nullptr},    {\"ggml_origin\", nullptr},   {\"ggml_version\", nullptr},\n                {\"backends\", nullptr},         {\"devices\", devices}};\n    Json model{{\"alias\", s.alias}, {\"directory\", s.directory}, {\"context_length\", nullable(s.context)},\n               {\"device\", s.device}, {\"prefill_device\", s.device}};\n    Json current = nullptr;\n    if (s.active) {\n        const auto started = std::chrono::duration<double>(s.active->started.time_since_epoch()).count();\n        const auto& a = s.active->accounting;\n        // Progress counted from what was forwarded so far.  A stream is in prefill until its first text fragment\n        // and in decode after it; a non-streaming request forwards nothing until it ends, so its phase and count\n        // are unknown (null) rather than shown as a prefill that never ends.  Input and reused counts appear once\n        // the forwarded data carries them (Messages' message_start; Chat's last chunk).\n        Json phase = nullptr, generated = nullptr;\n        if (a.streaming) {\n            phase = a.saw_content ? \"decode\" : \"prefill\";\n            generated = nullable(a.streamed_tokens);\n        }\n        current = {{\"endpoint\", s.active->endpoint}, {\"source\", s.active->source}, {\"phase\", phase},\n                   {\"started_steady_seconds\", started},\n                   {\"elapsed_seconds\", std::chrono::duration<double>(s.now - s.active->started).count()},\n                   {\"input_tokens\", nullable(a.input_tokens)}, {\"reused_tokens\", nullable(a.reused_tokens)},\n                   {\"computed_tokens\", nullptr}, {\"pending_tokens\", nullptr}, {\"generated_tokens\", generated}};\n        if (a.streaming && a.first_token_seconds) current[\"first_token_seconds\"] = *a.first_token_seconds;\n    }\n    Json recent = Json::array(), last = nullptr;\n    for (const auto& r : s.history.recent) recent.push_back(record_json(r));\n    if (s.history.last) {\n        // Required in `last`, n/a for a delegated model: null. Optional in recent_requests: absent.\n        last = record_json(*s.history.last);\n        for (const auto* field : {\"error_stage\", \"reuse_method\", \"computed_tokens\", \"decode_forwards\", \"checkpoint_restored\"})\n            last[field] = nullptr;\n        last[\"ended_at\"] = s.history.last->time;\n    }\n    const auto& t = s.history.totals;\n    Json totals{{\"requests\", t.requests}, {\"rejected_busy\", t.rejected_busy}, {\"rejected_invalid\", t.rejected_invalid},\n                {\"unauthorized\", t.unauthorized}, {\"input_tokens\", t.input_tokens}, {\"reused_tokens\", t.reused_tokens},\n                {\"computed_tokens\", nullptr}, {\"generated_tokens\", t.generated_tokens}, {\"checkpoint_restores\", nullptr},\n                {\"continued_turns\", nullptr}, {\"decode_seconds\", t.decode_seconds}};\n    if (t.first_count) totals[\"first_token_seconds_mean\"] = t.first_seconds / double(t.first_count);\n    if (t.prompt_seconds > 0) totals[\"prefill_tokens_per_second\"] = double(t.prompt_tokens_read) / t.prompt_seconds;\n    if (t.decode_seconds_rated > 0) totals[\"decode_tokens_per_second\"] = double(t.predicted_tokens) / t.decode_seconds_rated;\n    return {{\"instance\", s.instance}, {\"listen\", s.listen}, {\"engine\", engine}, {\"model\", model}, {\"current\", current},\n            {\"last\", last}, {\"totals\", totals}, {\"memory\", {{\"ledger\", nullptr}, {\"resident\", nullptr}, {\"physical\", nullptr}}},\n            {\"system\", system_memory(s.system, external)}, {\"recent_requests\", recent}};\n}\n}\n", "account_sse": "void account_sse(Accounting& a, std::string& pending, const char* data, std::size_t size, double elapsed) {\n    pending.append(data, size);\n    std::size_t start = 0;\n    for (;;) {\n        const auto end = pending.find('\\n', start);\n        if (end == std::string::npos) break;\n        std::string line = pending.substr(start, end - start);\n        start = end + 1;\n        if (!line.empty() && line.back() == '\\r') line.pop_back();\n        if (line.compare(0, 5, \"data:\") != 0) continue;\n        auto payload = line.substr(5);\n        if (!payload.empty() && payload.front() == ' ') payload.erase(0, 1);\n        if (payload == \"[DONE]\") {\n            if (a.endpoint == \"/v1/chat/completions\") a.complete = true;\n            continue;\n        }\n        const auto value = Json::parse(payload, nullptr, false);\n        if (value.is_discarded()) continue;\n        try {\n            const auto type = text(value, \"type\");\n            if (a.endpoint == \"/v1/responses\") {\n                if (type == \"response.completed\" || type == \"response.incomplete\" || type == \"response.failed\") a.complete = true;\n                if (value.contains(\"response\") && value[\"response\"].is_object()) {\n                    const auto id = text(value[\"response\"], \"id\");\n                    if (!id.empty()) a.response_id = id;\n                }\n                const auto id = text(value, \"response_id\");\n                if (!id.empty()) a.response_id = id;\n                if (value.contains(\"sequence_number\") && value[\"sequence_number\"].is_number_integer() && value[\"sequence_number\"] >= 0) {\n                    const auto n = value[\"sequence_number\"].get<std::uint64_t>();\n                    if (n < std::numeric_limits<std::size_t>::max()) a.next_sequence = std::max(a.next_sequence, static_cast<std::size_t>(n) + 1);\n                }\n            } else if (a.endpoint == \"/v1/messages\" && (type == \"message_stop\" || type == \"error\")) a.complete = true;\n            else if (a.endpoint == \"/v1/chat/completions\" && value.contains(\"error\")) a.complete = true;\n            account(a, value);\n            if (const auto fragments = content_fragments(value)) {\n                a.streamed_tokens = a.streamed_tokens.value_or(0) + fragments;\n                if (!a.saw_content) a.first_token_seconds = elapsed;\n                a.saw_content = true;\n            }\n        } catch (const std::exception&) {\n            // Accounting never affects forwarding: an event that cannot be read is left out of the record.\n        }\n    }\n    pending.erase(0, start);\n}", "per_line_parser_markers": true}
2026-11-16T21:48:31.5677421Z SSE_HISTORY_VERSION={"blob": "fca5876232d8bbca204b335e6567114f8c8b83ec", "paths": ["edge0-infer/tools/cli/serve_delegate_status.h"], "source": "#pragma once\n// /status, request records and response accounting for the delegate-mode proxy.\n// Pure functions: the proxy feeds them what it forwarded and what edge0-strata's\n// /v1/status reported; nothing here performs I/O.\n#include <nlohmann/json.hpp>\n#include <chrono>\n#include <cstdint>\n#include <deque>\n#include <functional>\n#include <utility>\n#include <optional>\n#include <string>\n#include <vector>\n\nnamespace delegate {\nusing StatusJson = nlohmann::ordered_json;\n\n// What the proxy can learn from one forwarded response (the external engine's own numbers).\nstruct Accounting {\n    std::optional<std::int64_t> input_tokens, reused_tokens, generated_tokens, prompt_tokens_read, predicted_tokens;\n    std::optional<double> prompt_seconds, decode_seconds, prefill_tokens_per_second, decode_tokens_per_second;\n    // Live progress of a request still in flight. The external engine reports its counts only in the last chunk,\n    // so the proxy counts what it forwards: `streamed_tokens` is the number of streamed fragments that carried\n    // text (one token each), `first_token_seconds` the request's age when the first of them arrived.  `streaming`\n    // says whether the request asked for a stream; a non-streaming request has no fragments to count.  None of\n    // these is used once the request ends: its record keeps only the engine's own numbers.\n    std::optional<std::int64_t> streamed_tokens;\n    std::optional<double> first_token_seconds;\n    bool saw_content = false, streaming = false, complete = false;\n    std::string endpoint, response_id;\n    std::size_t next_sequence = 0;\n    std::string finish;  // the external engine's finish reason, or failed for a protocol error\n    std::string error_code, error_message, error_param;\n};\n// Folds one JSON body or SSE data object into the accounting (later values win).\nvoid account(Accounting&, const StatusJson& body);\n// The number of text-carrying fragments in one streamed event (0 or 1 per Chat choice, 0 or 1 for a Responses or\n// Messages event): Chat `delta.content`, `delta.reasoning_content` or `delta.tool_calls[].function.arguments`;\n// Responses `response.output_text.delta`, `response.reasoning_text.delta`, `response.function_call_arguments.delta`\n// and `response.custom_tool_call_input.delta`; Messages `content_block_delta` with a `text_delta`, `thinking_delta`\n// or `input_json_delta`.  Empty text, a role, a finish reason, usage or timings alone count 0.\nstd::int64_t content_fragments(const StatusJson& event);\n// Splits SSE text into events and accounts each data object; keeps the unfinished tail in `pending`.  `elapsed` is\n// the request's age when this chunk arrived: the first fragment that carries text is stamped with it.\nvoid account_sse(Accounting&, std::string& pending, const char* data, std::size_t size, double elapsed = 0);\nstd::string stop_reason(const std::string& finish);\n\nstruct ProxyRecord {\n    std::string time, endpoint, source;\n    int http_status = 0;\n    bool stream = false, entered = false;\n    double total_seconds = 0;\n    std::string code, message, param, stop_reason;\n    Accounting accounting;\n};\nStatusJson record_json(const ProxyRecord&);\n\nstruct ProxyTotals {\n    std::size_t requests = 0, rejected_busy = 0, rejected_invalid = 0, unauthorized = 0;\n    std::int64_t input_tokens = 0, reused_tokens = 0, generated_tokens = 0, prompt_tokens_read = 0, predicted_tokens = 0;\n    double decode_seconds = 0, prompt_seconds = 0, first_seconds = 0;\n    std::size_t first_count = 0;\n    double decode_seconds_rated = 0;\n};\nstruct ProxyHistory {\n    ProxyTotals totals;\n    std::deque<ProxyRecord> recent;\n    std::optional<ProxyRecord> last;\n    void add(const ProxyRecord&);\n};\n\nstruct ActiveRequest {\n    std::string endpoint, source;\n    std::chrono::steady_clock::time_point started;\n    // A copy of the forwarded response's accounting, taken under the forward's mutex when the status is built.\n    Accounting accounting;\n};\nstruct DelegateStatusInput {\n    StatusJson instance, listen, system;\n    std::string alias, directory, device;\n    std::optional<std::int64_t> context;\n    StatusJson external = nullptr;  // edge0-strata's /v1/status, or null when it did not answer\n    std::optional<ActiveRequest> active;\n    std::chrono::steady_clock::time_point now;\n    ProxyHistory history;\n};\nStatusJson status_json(const DelegateStatusInput&);\n// Arm only after registration; release after finishing or handing ownership to a provider.\nclass ActiveGuard {\npublic:\n    explicit ActiveGuard(std::function<void()> finish) : finish_(std::move(finish)) {}\n    ActiveGuard(const ActiveGuard&) = delete;\n    ActiveGuard& operator=(const ActiveGuard&) = delete;\n    ~ActiveGuard() noexcept { if (armed_) { try { finish_(); } catch (...) {} } }\n    void arm() noexcept { armed_ = true; }\n    void release() noexcept { armed_ = false; }\nprivate:\n    std::function<void()> finish_;\n    bool armed_ = false;\n};\nStatusJson proxy_error(int status, const std::string& path = {});\n// Replaces system.memory with the external engine's machine.ram reading.\nStatusJson system_memory(const StatusJson& portal_system, const StatusJson& external);\n}\n"}
2026-11-16T21:48:31.5758113Z SSE_HISTORY_VERSION={"blob": "94894091318896a2335d95240ecdfab1dec26a6c", "paths": ["edge0-infer/tools/cli/serve_delegate_proxy.cpp"], "source": "#include \"serve_delegate.h\"\n#include \"serve_delegate_status.h\"\n#include \"serve_status.h\"\n#include \"serve_protocol.h\"\n#include \"edge0/diagnostics.h\"\n#include <httplib.h>\n#include <condition_variable>\n#include <csignal>\n#include <cstdlib>\n#include <ctime>\n#include <deque>\n#include <exception>\n#include <fstream>\n#include <iomanip>\n#include <iostream>\n#include <set>\n#include <sstream>\n\n// serve in delegate mode: edge0-strata runs on a loopback port and this process is\n// its proxy. Generation endpoints are forwarded byte for byte (SSE chunk by chunk);\n// /health, /v1/models and /status are answered here in Edge0's format (/health also\n// carries edge0-strata's own fields); GET /v1/status, /metrics and /props pass through.\nnamespace delegate {\nnamespace {\nusing Json = nlohmann::ordered_json;\nstd::atomic<bool> interrupted{false};\nvoid on_signal(int value) {\n#ifdef _WIN32\n    // The Windows CRT resets a signal handler before calling it. Keep repeated stop requests graceful.\n    std::signal(value, on_signal);\n#else\n    (void)value;\n#endif\n    interrupted = true;\n}\nstd::mutex log_mutex;\nvoid log(const std::string& text) {\n    std::lock_guard<std::mutex> lock(log_mutex);\n    std::cerr << text << '\\n' << std::flush;\n}\nstd::string timestamp() {\n    const auto now = std::chrono::system_clock::now();\n    const auto value = std::chrono::system_clock::to_time_t(now);\n    std::tm utc{};\n#ifdef _WIN32\n    gmtime_s(&utc, &value);\n#else\n    gmtime_r(&value, &utc);\n#endif\n    std::ostringstream out;\n    out << std::put_time(&utc, \"%Y-%m-%dT%H:%M:%S\") << '.' << std::setfill('0') << std::setw(3)\n        << std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count() % 1000 << 'Z';\n    return out.str();\n}\nJson error_body(const std::string& message, const std::string& code, int status=500, const std::string& path={}) {\n    if(path==\"/v1/messages\" || path.rfind(\"/v1/messages/\",0)==0)return portal::Failure(status,message,code).body(portal::Protocol::messages);\n    return {{\"error\", {{\"message\", message}, {\"type\", \"server_error\"}, {\"code\", code}, {\"param\", nullptr}}}};\n}\n\n// One forwarded request: a worker thread performs the upstream call and hands the\n// response over as it arrives; the HTTP handler (or its chunked provider) relays it.\nstruct Forward {\n    std::mutex mutex;\n    std::condition_variable changed;\n    std::deque<std::string> chunks;\n    bool headers = false, done = false, failed = false, complete = false;\n    int status = 0;\n    std::string content_type, body, failure_code, failure_message;\n    std::atomic<bool> cancel{false};\n    std::unique_ptr<httplib::Client> client;\n    std::thread worker;\n    std::chrono::steady_clock::time_point started = std::chrono::steady_clock::now();\n    std::string endpoint, source;\n    bool stream = false, client_gone = false;\n    Accounting accounting;\n    std::string pending;\n    void abort() {\n        cancel = true;\n        if (client) client->stop();\n    }\n    ~Forward() {\n        abort();\n        if (worker.joinable()) worker.join();\n    }\n};\n\nstruct ServeArgs {\n    CommonArgs common;\n    std::string host = \"127.0.0.1\", key_file;\n    int port = 8000, write_timeout = 30;\n    std::size_t max_body = 16 * 1024 * 1024;\n};\nServeArgs parse(int argc, char** argv) {\n    ServeArgs args;\n    for (int i = 2; i < argc; ++i) {\n        const std::string key = argv[i];\n        if (key == \"--verbose\") continue;\n        if (key == \"--no-warmup\") unsupported_option(key);\n        if (i + 1 >= argc) throw ConfigError(\"invalid_argument: missing value for \" + key);\n        const std::string value = argv[++i];\n        auto number = [&](std::int64_t limit) {\n            if (value.empty() || value.size() > 18 || value.find_first_not_of(\"0123456789\") != std::string::npos || std::stoll(value) > limit)\n                throw ConfigError(\"invalid_argument: invalid value for \" + key);\n            return std::stoll(value);\n        };\n        if (common_argument(key, value, args.common)) {}\n        else if (key == \"--host\") args.host = value;\n        else if (key == \"--port\") args.port = static_cast<int>(number(65535));\n        else if (key == \"--api-key-file\") args.key_file = value;\n        else if (key == \"--write-timeout-seconds\") { args.write_timeout = static_cast<int>(number(INT32_MAX)); if (!args.write_timeout) throw ConfigError(\"invalid_argument: invalid write timeout\"); }\n        else if (key == \"--max-body-bytes\") args.max_body = static_cast<std::size_t>(number(INT64_MAX));\n        else unsupported_option(key);\n    }\n    return args;\n}\n}\n\nint serve(int argc, char** argv, const Match& match) {\n    try {\n        const auto args = parse(argc, argv);\n        const char* cuda_path = std::getenv(\"CUDA_PATH\");\n        const auto options = resolve(args.common, match, executable_path(argv[0]), host_platform(), cuda_path ? cuda_path : \"\");\n        for (const auto& warning : options.warnings) std::cerr << \"warning: \" << warning << '\\n';\n        std::string api_token;\n        if (!args.key_file.empty()) {\n            std::ifstream input(args.key_file, std::ios::binary);\n            if (!input) throw ConfigError(\"Cannot read API key file\");\n            std::ostringstream content;\n            content << input.rdbuf();\n            api_token = content.str();\n            const auto first = api_token.find_first_not_of(\" \\t\\r\\n\\f\\v\");\n            if (first == std::string::npos) throw ConfigError(\"API key file is empty\");\n            api_token = api_token.substr(first, api_token.find_last_not_of(\" \\t\\r\\n\\f\\v\") - first + 1);\n        }\n        if (!portal::loopback(args.host) && args.host != \"localhost\" && api_token.empty())\n            throw ConfigError(\"Non-loopback listening requires --api-key-file\");\n\n        interrupted = false;\n        auto old_int = std::signal(SIGINT, on_signal), old_term = std::signal(SIGTERM, on_signal);\n#ifdef _WIN32\n        auto old_break = std::signal(SIGBREAK, on_signal);\n        struct RestoreBreak { void (*handler)(int); ~RestoreBreak() { std::signal(SIGBREAK, handler); } } restore_break{old_break};\n#endif\n        struct Restore {\n            void (*a)(int); void (*b)(int);\n            ~Restore() { std::signal(SIGINT, a); std::signal(SIGTERM, b); }\n        } restore{old_int, old_term};\n\n        log(\"edge0-strata: starting \" + match.registration->id + \" from \" + options.strata_dir.string() + \" on \" + options.device);\n        auto launched = launch(*match.registration, options, {}, &interrupted);\n        auto& engine = *launched->engine;\n        const int upstream_port = engine.port();\n        log(\"edge0-strata: ready (pid \" + std::to_string(engine.pid()) + \", port \" + std::to_string(upstream_port) + \")\");\n        auto fetch_status = [&]() -> Json {\n            httplib::Client client(\"127.0.0.1\", upstream_port);\n            client.set_tcp_nodelay(true);\n            client.set_connection_timeout(1);\n            client.set_read_timeout(3);\n            auto response = client.Get(\"/v1/status\");\n            if (!response || response->status != 200) return nullptr;\n            auto value = Json::parse(response->body, nullptr, false);\n            return value.is_discarded() ? Json(nullptr) : value;\n        };\n        std::optional<std::int64_t> context;\n        if (const auto status = fetch_status(); status.is_object() && status.contains(\"context\") && status[\"context\"].is_object() &&\n                                                status[\"context\"].contains(\"native\") && status[\"context\"][\"native\"].is_number_integer())\n            context = status[\"context\"][\"native\"].get<std::int64_t>();\n\n        const auto started = std::chrono::steady_clock::now();\n        const auto unix_ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();\n#ifdef _WIN32\n        const auto pid = GetCurrentProcessId();\n#else\n        const auto pid = getpid();\n#endif\n        const auto started_at = timestamp();\n        const std::string device = options.device;\n        std::atomic<bool> stopping{false};\n        std::mutex state_mutex;\n        ProxyHistory history;\n        std::set<std::shared_ptr<Forward>> active;\n        std::condition_variable idle;\n        auto save = [&](const ProxyRecord& record) {\n            std::lock_guard<std::mutex> lock(state_mutex);\n            history.add(record);\n            log(record_json(record).dump());\n        };\n        auto finish = [&](const std::shared_ptr<Forward>& f, int http_status) {\n            {\n                std::lock_guard<std::mutex> lock(state_mutex);\n                active.erase(f);\n                idle.notify_all();\n            }\n            ProxyRecord record;\n            record.time = timestamp();\n            record.endpoint = f->endpoint;\n            record.source = f->source;\n            record.stream = f->stream;\n            record.total_seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - f->started).count();\n            record.http_status = http_status;\n            record.accounting = f->accounting;\n            record.entered = http_status < 400 || http_status >= 500;\n            if (http_status == 429) record.entered = false;\n            if (f->client_gone) record.stop_reason = \"cancelled\";\n            else if (http_status >= 400) record.stop_reason = \"failed\";\n            else record.stop_reason = stop_reason(f->accounting.finish);\n            if (http_status >= 400) {\n                const auto body = Json::parse(f->body, nullptr, false);\n                if (!body.is_discarded() && body.contains(\"error\") && body[\"error\"].is_object()) {\n                    const auto& error = body[\"error\"];\n                    if (error.contains(\"code\") && error[\"code\"].is_string()) record.code = error[\"code\"];\n                    else if (error.contains(\"type\") && error[\"type\"].is_string()) record.code = error[\"type\"];\n                    if (error.contains(\"message\") && error[\"message\"].is_string()) record.message = error[\"message\"];\n                    if (error.contains(\"param\") && error[\"param\"].is_string()) record.param = error[\"param\"];\n                }\n            }\n            if (!f->failure_code.empty()) {record.code = f->failure_code;record.message = f->failure_message;}\n            save(record);\n        };\n\n        httplib::Server server;\n        server.set_tcp_nodelay(true);\n        server.set_socket_options([](socket_t socket) {\n#ifdef _WIN32\n            const auto option = SO_EXCLUSIVEADDRUSE;\n#else\n            const auto option = SO_REUSEADDR;\n#endif\n            if (!httplib::set_socket_opt(socket, SOL_SOCKET, option, 1)) throw std::runtime_error(\"Cannot configure exclusive server binding\");\n        });\n        server.new_task_queue = [] { return new httplib::ThreadPool(16); };\n        server.set_payload_max_length(args.max_body);\n        server.set_write_timeout(args.write_timeout);\n        auto send_error = [](httplib::Response& res, int status, const std::string& message, const std::string& code, const std::string& path=std::string{}) {\n            res.status = status;\n            res.set_content(error_body(message, code, status, path).dump(), \"application/json\");\n        };\n        server.set_error_handler([&](const httplib::Request& req, httplib::Response& res) {\n            if (res.status == 413) send_error(res, 413, \"Request body too large\", \"request_too_large\", req.path);\n            else if (res.body.empty()) res.set_content(proxy_error(res.status, req.path).dump(), \"application/json\");\n        });\n        server.set_pre_routing_handler([&](const httplib::Request& req, httplib::Response& res) {\n            if (portal::authorized(req.remote_addr, api_token, req.get_header_value(\"Authorization\"), req.get_header_value(\"x-api-key\")))\n                return httplib::Server::HandlerResponse::Unhandled;\n            send_error(res, 401, \"Invalid API key\", \"invalid_api_key\", req.path);\n            ProxyRecord record;\n            record.time = timestamp();\n            record.endpoint = req.path;\n            record.source = req.remote_addr;\n            record.http_status = 401;\n            record.code = \"invalid_api_key\";\n            record.message = \"Invalid API key\";\n            save(record);\n            return httplib::Server::HandlerResponse::Handled;\n        });\n        int bound_port = 0;\n        auto healthy = [&] { return !stopping && engine.running(); };\n        server.Get(\"/health\", [&](const httplib::Request&, httplib::Response& res) {\n            if (stopping) send_error(res, 503, \"Server shutting down\", \"shutting_down\");\n            else if (!engine.running()) send_error(res, 503, \"edge0-strata has exited\", \"engine_exited\");\n            else {\n                // Edge0's answer with edge0-strata's own /health fields merged in (status stays Edge0's), so that\n                // tools written for edge0-strata, such as its benchmark, recognize the proxy.\n                Json body{{\"status\", \"ok\"}};\n                httplib::Client client(\"127.0.0.1\", upstream_port);\n                client.set_tcp_nodelay(true);\n                client.set_connection_timeout(1);\n                client.set_read_timeout(3);\n                if (auto upstream = client.Get(\"/health\"); upstream && upstream->status == 200) {\n                    const auto value = Json::parse(upstream->body, nullptr, false);\n                    if (value.is_object())\n                        for (const auto& item : value.items())\n                            if (item.key() != \"status\") body[item.key()] = item.value();\n                }\n                res.set_content(body.dump(), \"application/json\");\n            }\n        });\n        // edge0-strata's own description endpoints, passed through unchanged for its tools (Edge0's is /status).\n        for (const char* path : {\"/v1/status\", \"/metrics\", \"/props\"})\n            server.Get(path, [&, path](const httplib::Request&, httplib::Response& res) {\n                if (!healthy()) {\n                    if (stopping) send_error(res, 503, \"Server shutting down\", \"shutting_down\");\n                    else send_error(res, 503, \"edge0-strata has exited\", \"engine_exited\");\n                    return;\n                }\n                httplib::Client client(\"127.0.0.1\", upstream_port);\n                client.set_tcp_nodelay(true);\n                client.set_connection_timeout(5);\n                client.set_read_timeout(60);\n                auto upstream = client.Get(path);\n                if (!upstream) {\n                    send_error(res, 502, \"edge0-strata did not answer \" + std::string(path), \"upstream_unavailable\");\n                    return;\n                }\n                res.status = upstream->status;\n                res.set_content(upstream->body, upstream->has_header(\"Content-Type\") ? upstream->get_header_value(\"Content-Type\")\n                                                                                      : std::string(\"application/octet-stream\"));\n            });\n        server.Post(\"/v1/messages/count_tokens\", [&](const httplib::Request& req, httplib::Response& res) {\n            if (!healthy()) {\n                send_error(res, 503, stopping ? \"Server shutting down\" : \"edge0-strata has exited\",\n                           stopping ? \"shutting_down\" : \"engine_exited\", req.path);\n                return;\n            }\n            httplib::Client client(\"127.0.0.1\", upstream_port);\n            client.set_tcp_nodelay(true);\n            client.set_connection_timeout(5);\n            client.set_read_timeout(60);\n            client.set_path_encode(false);\n            httplib::Headers headers;\n            for (const char* name : {\"Accept\", \"anthropic-version\", \"anthropic-beta\"})\n                if (req.has_header(name)) headers.emplace(name, req.get_header_value(name));\n            auto upstream = client.Post(req.target.empty() ? req.path : req.target, headers, req.body,\n                                        req.get_header_value(\"Content-Type\"));\n            if (!upstream) {send_error(res, 502, \"edge0-strata did not answer\", \"upstream_unavailable\", req.path);return;}\n            res.status = upstream->status;\n            res.set_content(upstream->body, upstream->has_header(\"Content-Type\") ? upstream->get_header_value(\"Content-Type\")\n                                                                               : \"application/octet-stream\");\n        });\n        auto model_object = [&] {\n            return Json{{\"id\", options.alias}, {\"object\", \"model\"}, {\"created\", 0}, {\"owned_by\", \"local\"},\n                        {\"context_length\", context ? Json(*context) : Json(nullptr)},\n                        {\"capabilities\", {{\"thinking\", match.registration->thinking}, {\"thinking_default\", match.registration->thinking_default}}}};\n        };\n        server.Get(\"/v1/models\", [&](const httplib::Request&, httplib::Response& res) {\n            res.set_content(Json{{\"object\", \"list\"}, {\"data\", Json::array({model_object()})}}.dump(), \"application/json\");\n        });\n        server.Get(R\"(/v1/models/(.+))\", [&](const httplib::Request& req, httplib::Response& res) {\n            if (req.matches[1].str() != options.alias) send_error(res, 404, \"Unknown model\", \"model_not_found\");\n            else res.set_content(model_object().dump(), \"application/json\");\n        });\n        server.Get(\"/status\", [&](const httplib::Request&, httplib::Response& res) {\n            DelegateStatusInput input;\n            input.now = std::chrono::steady_clock::now();\n            input.instance = {{\"id\", std::to_string(pid) + \"-\" + std::to_string(unix_ms)}, {\"pid\", pid}, {\"started_at\", started_at},\n                              {\"uptime_seconds\", std::chrono::duration<double>(input.now - started).count()}};\n            input.listen = {{\"host\", args.host}, {\"port\", bound_port}, {\"auth\", !api_token.empty()}};\n            input.alias = options.alias;\n            input.directory = args.common.model;\n            input.device = device;\n            input.context = context;\n            input.system = portal::system_json(edge0::query_system_status());\n            input.external = engine.running() ? fetch_status() : Json(nullptr);\n            {\n                std::lock_guard<std::mutex> lock(state_mutex);\n                input.history = history;\n                for (const auto& f : active)\n                    if (!input.active || f->started < input.active->started) {\n                        // The accounting is written under the forward's own mutex; copying it there gives the live\n                        // phase and fragment count without racing the forwarding thread.\n                        std::lock_guard<std::mutex> stream_lock(f->mutex);\n                        input.active = ActiveRequest{f->endpoint, f->source, f->started, f->accounting};\n                    }\n                // Taken after the copy, so the elapsed time is never negative and never below the time stamped on\n                // the first fragment of the copied accounting.\n                input.now = std::chrono::steady_clock::now();\n            }\n            res.set_content(status_json(input).dump(), \"application/json\");\n        });\n        auto forward = [&](const httplib::Request& req, httplib::Response& res) {\n            auto f = std::make_shared<Forward>();\n            f->endpoint = req.path;\n            f->source = req.remote_addr;\n            f->accounting.endpoint = req.path;\n            {\n                const auto body = Json::parse(req.body, nullptr, false);\n                f->stream = !body.is_discarded() && body.is_object() && body.contains(\"stream\") && body[\"stream\"] == true;\n                f->accounting.streaming = f->stream;\n            }\n            if (!healthy()) {\n                f->body = stopping ? error_body(\"Server shutting down\", \"shutting_down\",503,req.path).dump()\n                                   : error_body(\"edge0-strata has exited\", \"engine_exited\",503,req.path).dump();\n                res.status = 503;\n                res.set_content(f->body, \"application/json\");\n                finish(f, 503);\n                return;\n            }\n            f->client = std::make_unique<httplib::Client>(\"127.0.0.1\", upstream_port);\n            f->client->set_tcp_nodelay(true);\n            ActiveGuard guard([&] {\n                f->abort();\n                if (f->worker.joinable()) f->worker.join();\n                f->failure_code = \"internal_error\";\n                f->failure_message = \"Internal error\";\n                finish(f, 500);\n            });\n            {\n                std::lock_guard<std::mutex> lock(state_mutex);\n                active.insert(f);\n            }\n            guard.arm();\n            f->client->set_connection_timeout(5);\n            f->client->set_read_timeout(24 * 3600);\n            f->client->set_write_timeout(60);\n            f->client->set_path_encode(false);  // the target goes out exactly as received\n            httplib::Request upstream;\n            upstream.method = \"POST\";\n            upstream.path = req.target.empty() ? req.path : req.target;  // keeps the query string (?beta=true)\n            upstream.body = req.body;\n            for (const char* name : {\"Content-Type\", \"Accept\", \"anthropic-version\", \"anthropic-beta\"})\n                if (req.has_header(name)) upstream.set_header(name, req.get_header_value(name));\n            std::weak_ptr<Forward> weak = f;\n            Forward* raw = f.get();\n            upstream.response_handler = [raw](const httplib::Response& response) {\n                std::lock_guard<std::mutex> lock(raw->mutex);\n                raw->status = response.status;\n                raw->content_type = response.get_header_value(\"Content-Type\");\n                raw->headers = true;\n                raw->changed.notify_all();\n                return !raw->cancel;\n            };\n            upstream.content_receiver = [raw](const char* data, std::size_t size, std::size_t, std::size_t) {\n                std::lock_guard<std::mutex> lock(raw->mutex);\n                raw->chunks.emplace_back(data, size);\n                raw->changed.notify_all();\n                return !raw->cancel;\n            };\n            f->worker = std::thread([raw, upstream] {\n                auto result = raw->client->send(upstream);\n                std::lock_guard<std::mutex> lock(raw->mutex);\n                raw->failed = !result;\n                raw->done = true;\n                raw->changed.notify_all();\n            });\n            {\n                std::unique_lock<std::mutex> lock(f->mutex);\n                while (!f->headers && !f->done) {\n                    f->changed.wait_for(lock, std::chrono::milliseconds(20));\n                    if (!f->headers && req.is_connection_closed()) { f->client_gone = true; lock.unlock(); f->abort(); lock.lock(); }\n                }\n            }\n            auto incomplete = [&, f] {\n                for (int i = 0; i < 20 && !f->client_gone && !stopping && engine.running(); ++i)\n                    std::this_thread::sleep_for(std::chrono::milliseconds(50));\n                const int status = f->client_gone ? 499 : stopping || !engine.running() ? 503 : 502;\n                f->failure_code = f->client_gone ? \"cancelled\" : stopping ? \"shutting_down\" : status == 503 ? \"engine_exited\" : \"engine_unavailable\";\n                f->failure_message = f->client_gone ? \"Client disconnected\" : stopping ? \"Server shutting down\" : status == 503 ? \"edge0-strata has exited\" : \"edge0-strata did not finish its response\";\n                f->status = status;\n                f->body = error_body(f->failure_message, f->failure_code, status, f->endpoint).dump();\n            };\n            if (!f->headers) {\n                if (f->worker.joinable()) f->worker.join();\n                incomplete();\n                res.status = f->status;\n                res.set_content(f->body, \"application/json\");\n                finish(f, f->status);\n                guard.release();\n                return;\n            }\n            res.status = f->status;\n            if (f->content_type.compare(0, 17, \"text/event-stream\") == 0) {\n                res.set_chunked_content_provider(\n                    f->content_type,\n                    [f, &req, incomplete, &options](std::size_t, httplib::DataSink& sink) {\n                        std::unique_lock<std::mutex> lock(f->mutex);\n                        for (;;) {\n                            while (!f->chunks.empty()) {\n                                auto chunk = std::move(f->chunks.front());\n                                f->chunks.pop_front();\n                                try {\n                                    // The request's age when this chunk is forwarded; the first text fragment is\n                                    // stamped with it (current.first_token_seconds).\n                                    const double elapsed =\n                                        std::chrono::duration<double>(std::chrono::steady_clock::now() - f->started).count();\n                                    account_sse(f->accounting, f->pending, chunk.data(), chunk.size(), elapsed);\n                                } catch (const std::exception&) {\n                                    // Accounting never affects forwarding; the record keeps what was read.\n                                }\n                                lock.unlock();\n                                const bool written = sink.write(chunk.data(), chunk.size());\n                                lock.lock();\n                                if (!written) { f->client_gone = true; lock.unlock(); f->abort(); return false; }\n                            }\n                            if (f->done) break;\n                            f->changed.wait_for(lock, std::chrono::milliseconds(20));\n                            if (f->chunks.empty() && !f->done && (!sink.is_writable() || req.is_connection_closed())) {\n                                f->client_gone = true;\n                                lock.unlock();\n                                f->abort();\n                                return false;\n                            }\n                        }\n                        f->complete = !f->failed && f->accounting.complete;\n                        lock.unlock();\n                        if (!f->complete) {\n                            incomplete();\n                            if (f->client_gone) return false;\n                            portal::Request request;\n                            request.protocol = f->endpoint == \"/v1/messages\" ? portal::Protocol::messages\n                                : f->endpoint == \"/v1/responses\" ? portal::Protocol::responses : portal::Protocol::chat;\n                            portal::Encoder encoder(request, options.alias, \"\");\n                            const portal::Failure error(f->status, f->failure_message, f->failure_code);\n                            // A truncated last line must not consume the appended event as part of its data.\n                            if (!sink.write(\"\\n\\n\", 2)) {f->client_gone = true;return false;}\n                            for (const auto& event : encoder.fail(error, f->accounting.response_id, f->accounting.next_sequence))\n                                if (!sink.write(event.data(), event.size())) {f->client_gone = true;return false;}\n                        }\n                        sink.done();\n                        return true;\n                    },\n                    [f, finish](bool) {\n                        f->abort();\n                        if (f->worker.joinable()) f->worker.join();\n                        finish(f, f->status);\n                    });\n                guard.release();\n                return;\n            }\n            {\n                std::unique_lock<std::mutex> lock(f->mutex);\n                while (!f->done) {\n                    f->changed.wait_for(lock, std::chrono::milliseconds(20));\n                    if (!f->done && req.is_connection_closed()) { f->client_gone = true; lock.unlock(); f->abort(); lock.lock(); }\n                }\n                for (auto& chunk : f->chunks) f->body += chunk;\n                f->chunks.clear();\n            }\n            if (f->worker.joinable()) f->worker.join();\n            const bool json_content = f->content_type.find(\"application/json\") != std::string::npos || f->content_type.find(\"+json\") != std::string::npos;\n            const auto parsed = json_content ? Json::parse(f->body, nullptr, false) : Json(nullptr);\n            f->complete = !f->failed && (!json_content || !parsed.is_discarded());\n            if (!f->complete) {\n                incomplete();\n                res.status = f->status;\n                res.set_content(f->body, \"application/json\");\n                finish(f, f->status);\n                guard.release();\n                return;\n            }\n            try {\n                // Under the forward's mutex: /status copies the accounting of a request that is still active.\n                std::lock_guard<std::mutex